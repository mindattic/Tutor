<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Tutor.Mcp</RootNamespace>
        <AssemblyName>Tutor.Mcp</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- See Tutor.Cli.csproj's matching comment: an Exe-to-Exe project reference needs both
             ends to agree on this, or a framework-dependent win-x64 publish fails with NETSDK1151. -->
        <SelfContained>false</SelfContained>
    </PropertyGroup>

    <ItemGroup>
        <!-- Anthropic's C# Model Context Protocol SDK. The server-side bits live in the
             core package; the package version intentionally floats so security updates
             flow without touching this csproj. -->
        <PackageReference Include="ModelContextProtocol" Version="*" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    </ItemGroup>

    <ItemGroup>
        <!-- Reuses CliSecurePreferences (Vault-backed, file-backed fallback) rather than
             standing up a third ISecurePreferences implementation just for this server. -->
        <ProjectReference Include="..\Tutor.Cli\Tutor.Cli.csproj" />
    </ItemGroup>

</Project>
