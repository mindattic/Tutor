<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Tutor.Core</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MindAttic.Legion" Version="25.0.0" />
        <PackageReference Include="MindAttic.Log" Version="3.0.0" />
        <PackageReference Include="MindAttic.Vault" Version="7.0.0" />
        <PackageReference Include="MindAttic.Export" Version="3.0.0" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />

        <!-- Auth: the unified, Vault-backed MindAttic.Authentication engine. Tutor's FIRST SQL
             dependency â€” an auth-only SQL Server DB (TutorAuthDbContext : IAuthDataContext);
             courses/progress stay JSON. -->
        <!-- Prod uses this clean package (dev auth bypass compiled out). In DEBUG only, the lib is ALSO
             referenced as source below; MSBuild prefers the project output, so a dev build gets the lib's
             Debug build (MA_DEV_AUTH â†’ localhost dev-login bypass). Never present in a release build. -->
        <PackageReference Include="MindAttic.Authentication" Version="7.0.0" />
        <ProjectReference Include="..\..\MindAttic.Authentication\src\MindAttic.Authentication\MindAttic.Authentication.csproj" Condition="'$(Configuration)' == 'Debug'" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.8" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <!-- Book parsers (PDF + Tesseract OCR, EPUB, HTML, DOCX, TXT, MOBI, LibreOffice), chunking and the
             embedding / vector-store abstractions live in the Tutor.Ingestion package (TUT-T64). It carries
             PdfPig, VersOne.Epub, AngleSharp, SmartReader, OpenXml and Tesseract transitively, and its
             buildTransitive targets copy tessdata/eng.traineddata to every host's output. -->
        <PackageReference Include="Tutor.Ingestion" Version="1.0.0" />

        <!-- Phase B: .doc / .rtf / .odt all shell out to LibreOffice's headless
             converter. NPOI 2.8 stopped shipping HWPF for legacy .doc, so it
             can't help us here. .mobi/.azw/.azw3 shell out to Calibre's
             ebook-convert. No NuGet packages needed for Phase B. -->

    </ItemGroup>

</Project>
