@using Tutor.Core.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MindAttic.Authentication
@inject NavigationManager Nav
@inject AppUiState UiState
@inject SettingsService Settings

<header class="top-menu" role="banner">
    <div class="top-menu-brand">
        <a href="" class="brand-link" aria-label="Tutor home">
            <span class="bi bi-mortarboard-fill" aria-hidden="true"></span>
            <span class="brand-text">Tutor</span>
        </a>
    </div>

    <nav class="top-menu-nav" aria-label="Primary">
        <NavLink class="top-nav-link" href="" Match="NavLinkMatch.All" @onclick="() => OnTabSelected(TopTab.Home)">
            <span class="bi bi-house-fill" aria-hidden="true"></span>
            <span>Home</span>
        </NavLink>
        <AuthorizeView>
            <Authorized>
                <NavLink class="top-nav-link" href="courses" Match="NavLinkMatch.Prefix" @onclick="() => OnTabSelected(TopTab.Courses)">
                    <span class="bi bi-book-fill" aria-hidden="true"></span>
                    <span>Courses</span>
                </NavLink>
                <NavLink class="top-nav-link" href="learn" Match="NavLinkMatch.Prefix" @onclick="() => OnTabSelected(TopTab.Learn)">
                    <span class="bi bi-mortarboard-fill" aria-hidden="true"></span>
                    <span>Learn</span>
                </NavLink>
                <AuthorizeView Policy="@MaPolicies.Admin" Context="adminCtx">
                    <NavLink class="top-nav-link" href="settings" Match="NavLinkMatch.Prefix" @onclick="() => OnTabSelected(TopTab.Settings)">
                        <span class="bi bi-gear-fill" aria-hidden="true"></span>
                        <span>Settings</span>
                    </NavLink>
                    <NavLink class="top-nav-link" href="users" Match="NavLinkMatch.Prefix">
                        <span class="bi bi-people-fill" aria-hidden="true"></span>
                        <span>Users</span>
                    </NavLink>
                </AuthorizeView>
            </Authorized>
        </AuthorizeView>
    </nav>

    <div class="profile-menu">
        <AuthorizeView Context="userCtx">
            <Authorized>
                <span class="profile-username">@(userCtx.User.Identity?.Name ?? "User")</span>
                <button class="profile-avatar"
                        type="button"
                        aria-label="Open user menu for @(userCtx.User.Identity?.Name ?? "User")"
                        aria-haspopup="menu"
                        aria-expanded="@showProfileMenu.ToString().ToLowerInvariant()"
                        aria-controls="profile-dropdown-menu"
                        @onclick="ToggleProfileMenu"
                        @onclick:stopPropagation="true">
                    @if (!string.IsNullOrEmpty(userCustomAvatar))
                    {
                        <img src="@userCustomAvatar" alt="" />
                    }
                    else
                    {
                        <span class="bi @userAvatarIcon" aria-hidden="true"></span>
                    }
                </button>
                @if (showProfileMenu)
                {
                    <div id="profile-dropdown-menu" class="profile-dropdown" role="menu" aria-label="User menu">
                        <a href="profile" class="dropdown-item" role="menuitem">
                            <span class="bi bi-person" aria-hidden="true"></span>
                            <span>My Profile</span>
                        </a>
                        <a href="account" class="dropdown-item" role="menuitem">
                            <span class="bi bi-gear" aria-hidden="true"></span>
                            <span>Account Settings</span>
                        </a>
                        <a href="progress" class="dropdown-item" role="menuitem">
                            <span class="bi bi-bar-chart" aria-hidden="true"></span>
                            <span>My Progress</span>
                        </a>
                        <div class="dropdown-divider" role="separator"></div>
                        <a href="help" class="dropdown-item" role="menuitem">
                            <span class="bi bi-question-circle" aria-hidden="true"></span>
                            <span>Help</span>
                        </a>
                        @* Sign-out is owned by the MindAttic.Authentication endpoint via the static-SSR
                           /account page (antiforgery POST). UserCircle (UiUx) adds one-click logout in Stage 4. *@
                        <a href="account" class="dropdown-item" role="menuitem">
                            <span class="bi bi-box-arrow-right" aria-hidden="true"></span>
                            <span>Log Out</span>
                        </a>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
    </div>
</header>

@code {
    private bool showProfileMenu = false;
    private string userAvatarIcon = "bi-person-fill";
    private string? userCustomAvatar;

    protected override void OnInitialized()
    {
        // Determine initial tab from current URL
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var path = uri.AbsolutePath.TrimStart('/').ToLowerInvariant();

        var tab = path switch
        {
            "" or "home" => TopTab.Learn,
            var p when p.StartsWith("learn") => TopTab.Learn,
            var p when p.StartsWith("courses") => TopTab.Courses,
            var p when p.StartsWith("knowledge-bases") => TopTab.KnowledgeGraph,
            var p when p.StartsWith("knowledge-graph") => TopTab.KnowledgeGraph,
            var p when p.StartsWith("settings") => TopTab.Settings,
            _ => TopTab.Learn
        };

        UiState.SetActiveTab(tab);
    }

    private void OnTabSelected(TopTab tab) => UiState.SetActiveTab(tab);

    private void ToggleProfileMenu() => showProfileMenu = !showProfileMenu;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            userAvatarIcon = await Settings.GetUserAvatarIconAsync();
            userCustomAvatar = await Settings.GetUserCustomAvatarAsync();
            StateHasChanged();
        }
    }
}
