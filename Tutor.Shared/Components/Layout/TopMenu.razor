@using Tutor.Core.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MindAttic.Authentication
@inject NavigationManager Nav
@inject AppUiState UiState

<header class="top-menu" role="banner">
    <div class="top-menu-brand">
        <a href="" class="brand-link" aria-label="Tutor home">
            <span class="bi bi-mortarboard-fill" aria-hidden="true"></span>
            <span class="brand-text">Tutor</span>
        </a>
    </div>

    <nav class="top-menu-nav" aria-label="Primary">
        <NavLink class="top-nav-link" href="" Match="NavLinkMatch.All" @onclick="() => OnTabSelected(TopTab.Home)">
            <span class="bi bi-house-fill" aria-hidden="true"></span>
            <span>Home</span>
        </NavLink>
        <AuthorizeView>
            <Authorized>
                <NavLink class="top-nav-link" href="courses" Match="NavLinkMatch.Prefix" @onclick="() => OnTabSelected(TopTab.Courses)">
                    <span class="bi bi-book-fill" aria-hidden="true"></span>
                    <span>Courses</span>
                </NavLink>
                <NavLink class="top-nav-link" href="learn" Match="NavLinkMatch.Prefix" @onclick="() => OnTabSelected(TopTab.Learn)">
                    <span class="bi bi-mortarboard-fill" aria-hidden="true"></span>
                    <span>Learn</span>
                </NavLink>
                <NavLink class="top-nav-link" href="library" Match="NavLinkMatch.Prefix">
                    <span class="bi bi-box-seam" aria-hidden="true"></span>
                    <span>Library</span>
                </NavLink>
                <AuthorizeView Policy="@MaPolicies.Admin" Context="adminCtx">
                    <NavLink class="top-nav-link" href="settings" Match="NavLinkMatch.Prefix" @onclick="() => OnTabSelected(TopTab.Settings)">
                        <span class="bi bi-gear-fill" aria-hidden="true"></span>
                        <span>Settings</span>
                    </NavLink>
                    <NavLink class="top-nav-link" href="users" Match="NavLinkMatch.Prefix">
                        <span class="bi bi-people-fill" aria-hidden="true"></span>
                        <span>Users</span>
                    </NavLink>
                </AuthorizeView>
            </Authorized>
        </AuthorizeView>
    </nav>

    <div class="profile-menu">
        @* Shared MindAttic.UiUx avatar + sign-out (renders only when authenticated; logout is a
           native antiforgery POST to /_ma-auth/logout). *@
        <UserCircle />
    </div>
</header>

@code {
    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var path = uri.AbsolutePath.TrimStart('/').ToLowerInvariant();

        var tab = path switch
        {
            "" or "home" => TopTab.Learn,
            var p when p.StartsWith("learn") => TopTab.Learn,
            var p when p.StartsWith("courses") => TopTab.Courses,
            var p when p.StartsWith("knowledge-bases") => TopTab.KnowledgeGraph,
            var p when p.StartsWith("knowledge-graph") => TopTab.KnowledgeGraph,
            var p when p.StartsWith("settings") => TopTab.Settings,
            _ => TopTab.Learn
        };

        UiState.SetActiveTab(tab);
    }

    private void OnTabSelected(TopTab tab) => UiState.SetActiveTab(tab);
}
