@using Microsoft.AspNetCore.Components.Authorization
@using MindAttic.Authentication

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="" aria-label="Tutor home">Tutor</a>
    </div>
</div>

<input type="checkbox" title="Toggle navigation menu" aria-label="Toggle navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column" aria-label="Primary">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span>
                <span>Home</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="learn">
                <span class="bi bi-mortarboard-fill" aria-hidden="true"></span>
                <span>Learn</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="instructions">
                <span class="bi bi-list-check" aria-hidden="true"></span>
                <span>Instructions</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="courses">
                <span class="bi bi-book-fill" aria-hidden="true"></span>
                <span>Courses</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="knowledge-graph">
                <span class="bi bi-diagram-3" aria-hidden="true"></span>
                <span>Knowledge Graph</span>
            </NavLink>
        </div>
        <AuthorizeView Policy="@MaPolicies.Admin">
        <div class="nav-item px-3">
            @* LAMP (TUT-T31): settings open in MindAttic Vault, never in Tutor (admins only, as the old page was). *@
            <button class="nav-link" type="button" @onclick="OpenSettings" title="Open Tutor's settings in MindAttic Vault">
                <span class="bi bi-gear-fill" aria-hidden="true"></span>
                <span>Settings</span>
            </button>
            @if (!string.IsNullOrEmpty(settingsMessage))
            {
                <p class="nav-status" role="status">@settingsMessage <a href="@Tutor.Core.Services.SettingsCog.Link()">Open Vault</a></p>
            }
        </div>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? settingsMessage;

    /// <summary>The Settings cog: opens MindAttic Vault at Tutor's tab (no settings editor in Tutor).</summary>
    private void OpenSettings()
    {
        var result = Tutor.Core.Services.SettingsCog.Open();
        settingsMessage = result.Opened ? null : result.Message;
    }
}
