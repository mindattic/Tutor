@page "/forgot-password"
@using Microsoft.AspNetCore.Authorization
@using MindAttic.Authentication.Components
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Forgot password</PageTitle>

<div class="home-page">
    <div class="auth-container">
        <section class="auth-card" aria-labelledby="forgot-password-heading">
            <h1 id="forgot-password-heading">Forgot password</h1>
            @* Static-SSR. MaForgotPassword posts to /_ma-auth/reset/request, which is enumeration-safe and
               always redirects to /login?reset=sent. The emailed link opens /account/reset. *@
            <MaForgotPassword />
            <p><a href="/login">Back to sign in</a></p>
        </section>
    </div>
</div>
