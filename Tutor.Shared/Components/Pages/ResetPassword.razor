@page "/account/reset"
@using Microsoft.AspNetCore.Authorization
@using MindAttic.Authentication.Components
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Reset password</PageTitle>

<div class="home-page">
    <div class="auth-container">
        <section class="auth-card" aria-labelledby="reset-password-heading">
            <h1 id="reset-password-heading">Reset password</h1>
            @* Target of the emailed link: MindAttic:Auth:Reset:PublicBaseUrl + ResetPath (/account/reset)
               + ?token=. MaResetPassword posts to /_ma-auth/reset/confirm, which redirects to
               /login?reset=ok on success or back here with ?error=1&token=... *@
            <MaResetPassword Token="@Token" Error="@(Error == 1)" />
        </section>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }
    [SupplyParameterFromQuery] public int Error { get; set; }
}
