@page "/account/change-password"
@using Microsoft.AspNetCore.Authorization
@using MindAttic.Authentication.Components
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Change password</PageTitle>

<div class="home-page">
    <div class="auth-container">
        <section class="auth-card" aria-labelledby="change-password-heading">
            <h1 id="change-password-heading">Change password</h1>
            @* Forced-step landing. MaChangePassword posts to /_ma-auth/change-password (current-password
               verification); success -> /account?changed=1, failure -> /account/change-password?error=1. *@
            <MaChangePassword Error="@(Error == 1)" />
        </section>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public int Error { get; set; }
}
