@page "/login"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Sign in</PageTitle>

<div class="home-page">
    <div class="auth-container">
        <section class="auth-card" aria-labelledby="login-heading">
            <div class="auth-header">
                <span class="bi bi-mortarboard-fill auth-icon" aria-hidden="true"></span>
                <h1 id="login-heading">Welcome to Tutor</h1>
                <p class="auth-subtitle">Your AI-Powered Learning Companion</p>
            </div>
            @* Static-SSR; UserLogin (MindAttic.UiUx) styles the library MaLogin form, which posts to
               the antiforgery-protected /_ma-auth/login endpoint. Failure redirects here with ?error=1. *@
            @if (Reset == "sent")
            {
                <p role="status">If an account matches, we've emailed a password-reset link.</p>
            }
            else if (Reset == "ok")
            {
                <p role="status">Your password was reset. Sign in with the new password.</p>
            }
            <UserLogin ReturnUrl="@ReturnUrl" Error="@(Error == 1)" />
            <p><a href="/forgot-password">Forgot password?</a></p>
        </section>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public int Error { get; set; }
    /// <summary>Set by the library's reset endpoints: "sent" after a request, "ok" after a successful reset.</summary>
    [SupplyParameterFromQuery] public string? Reset { get; set; }
}
