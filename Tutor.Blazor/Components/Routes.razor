@using Microsoft.AspNetCore.Components.Authorization
@using Tutor.Shared.Components
@using Tutor.Shared.Components.Layout
@using Tutor.Shared.Components.Pages

<Router AppAssembly="typeof(Home).Assembly"
        AdditionalAssemblies="new[] { typeof(Routes).Assembly }">
    <Found Context="routeData">
        @* AuthorizeRouteView so [Authorize] pages are enforced; anonymous hits route to the
           MindAttic.Authentication login. Pages without [Authorize] render for everyone. *@
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
