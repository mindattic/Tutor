@using Microsoft.AspNetCore.Components.Authorization
@using Tutor.Shared.Components
@using Tutor.Shared.Components.Layout
@using Tutor.Shared.Components.Pages

<Router AppAssembly="typeof(Home).Assembly"
        AdditionalAssemblies="new[] { typeof(Routes).Assembly }">
    <Found Context="routeData">
        @* AuthorizeRouteView so [Authorize] pages are enforced; anonymous hits route to the
           MindAttic.Authentication login. Default-deny (TUT-T52): the fallback policy in
           Hosting/TutorAccess.cs already requires a signed-in user for every page and for the hub itself,
           except the [AllowAnonymous] pages on TutorAccess.AnonymousRoutes. *@
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    @* Signed in but missing the page's policy (e.g. a Student on an Author page, TUT-T59). *@
                    <section role="alert" aria-labelledby="not-allowed-heading">
                        <h1 id="not-allowed-heading">Not available</h1>
                        <p>Your account does not have access to this page.</p>
                        <p><a href="/">Return to the home page</a></p>
                    </section>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
