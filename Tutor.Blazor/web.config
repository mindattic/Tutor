<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- startupTimeLimit (TUT-T47): startup reads the auth database before it listens, and the first
           connection to the auto-paused Azure SQL database takes about a minute; the 120 s default kills
           the process mid-resume. Only IIS / Azure App Service read this file. -->
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%"
                  stdoutLogEnabled="false" stdoutLogFile="\\?\%home%\LogFiles\stdout"
                  hostingModel="inprocess" startupTimeLimit="600" />
    </system.webServer>
  </location>
</configuration>